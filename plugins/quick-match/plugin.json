{
  "id": "quick-match",
  "name": "Quick Match",
  "version": "1.0.0",
  "abi": 1,
  "entry": "quick-match.dll",
  "summary": "Boot straight into a match: no intro, title or select screens. Pick the fighters, the stage and the rules once, and restart the match with one key.",
  "author": "PascalPatch",
  "license": "GPL-2.0-or-later",
  "tags": ["training", "menus"],
  "settings": [
    {"key": "start", "type": "choice", "label": "When the game starts", "default": "match", "group": "Start", "options": [{"value": "match", "label": "Go straight into a match"}, {"value": "menus", "label": "Show the title screen, as usual"}], "help": "Takes effect the next time the game starts."},
    {"key": "p1", "type": "choice", "label": "Player 1", "default": "fox", "group": "Match", "options": [{"value": "falcon", "label": "Captain Falcon"}, {"value": "dk", "label": "Donkey Kong"}, {"value": "fox", "label": "Fox"}, {"value": "gnw", "label": "Mr. Game & Watch"}, {"value": "kirby", "label": "Kirby"}, {"value": "bowser", "label": "Bowser"}, {"value": "link", "label": "Link"}, {"value": "luigi", "label": "Luigi"}, {"value": "mario", "label": "Mario"}, {"value": "marth", "label": "Marth"}, {"value": "mewtwo", "label": "Mewtwo"}, {"value": "ness", "label": "Ness"}, {"value": "peach", "label": "Peach"}, {"value": "pikachu", "label": "Pikachu"}, {"value": "ics", "label": "Ice Climbers"}, {"value": "jigglypuff", "label": "Jigglypuff"}, {"value": "samus", "label": "Samus"}, {"value": "yoshi", "label": "Yoshi"}, {"value": "zelda", "label": "Zelda"}, {"value": "sheik", "label": "Sheik"}, {"value": "falco", "label": "Falco"}, {"value": "ylink", "label": "Young Link"}, {"value": "doc", "label": "Dr. Mario"}, {"value": "roy", "label": "Roy"}, {"value": "pichu", "label": "Pichu"}, {"value": "ganondorf", "label": "Ganondorf"}]},
    {"key": "p2", "type": "choice", "label": "Player 2", "default": "falco", "group": "Match", "options": [{"value": "falcon", "label": "Captain Falcon"}, {"value": "dk", "label": "Donkey Kong"}, {"value": "fox", "label": "Fox"}, {"value": "gnw", "label": "Mr. Game & Watch"}, {"value": "kirby", "label": "Kirby"}, {"value": "bowser", "label": "Bowser"}, {"value": "link", "label": "Link"}, {"value": "luigi", "label": "Luigi"}, {"value": "mario", "label": "Mario"}, {"value": "marth", "label": "Marth"}, {"value": "mewtwo", "label": "Mewtwo"}, {"value": "ness", "label": "Ness"}, {"value": "peach", "label": "Peach"}, {"value": "pikachu", "label": "Pikachu"}, {"value": "ics", "label": "Ice Climbers"}, {"value": "jigglypuff", "label": "Jigglypuff"}, {"value": "samus", "label": "Samus"}, {"value": "yoshi", "label": "Yoshi"}, {"value": "zelda", "label": "Zelda"}, {"value": "sheik", "label": "Sheik"}, {"value": "falco", "label": "Falco"}, {"value": "ylink", "label": "Young Link"}, {"value": "doc", "label": "Dr. Mario"}, {"value": "roy", "label": "Roy"}, {"value": "pichu", "label": "Pichu"}, {"value": "ganondorf", "label": "Ganondorf"}]},
    {"key": "p2_player", "type": "choice", "label": "Player 2 is", "default": "human", "group": "Match", "options": [{"value": "human", "label": "A human player (Training Lab's dummy can play it)"}, {"value": "cpu1", "label": "CPU level 1"}, {"value": "cpu3", "label": "CPU level 3"}, {"value": "cpu5", "label": "CPU level 5"}, {"value": "cpu7", "label": "CPU level 7"}, {"value": "cpu9", "label": "CPU level 9"}, {"value": "none", "label": "Nobody (player 1 alone)"}]},
    {"key": "stage", "type": "choice", "label": "Stage", "default": "fd", "group": "Match", "options": [{"value": "fd", "label": "Final Destination"}, {"value": "bf", "label": "Battlefield"}, {"value": "ys", "label": "Yoshi's Story"}, {"value": "fod", "label": "Fountain of Dreams"}, {"value": "ps", "label": "Pokemon Stadium"}, {"value": "dl", "label": "Dream Land N64"}]},
    {"key": "rules", "type": "choice", "label": "Rules", "default": "endless", "group": "Match", "options": [{"value": "endless", "label": "Endless: no time limit, no stocks (practice)"}, {"value": "stock4", "label": "4 stocks, 8 minutes"}, {"value": "stock1", "label": "1 stock, 8 minutes"}]},
    {"key": "restart_key", "type": "key", "label": "Restart the match", "default": "Backspace", "group": "Match"}
  ]
}
