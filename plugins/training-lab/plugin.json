{
  "id": "training-lab",
  "name": "Training Lab",
  "version": "1.1.0",
  "abi": 1,
  "entry": "training-lab.dll",
  "summary": "Pause, frame advance, slow motion, savestates, percent lock and infinite shield, plus a practice dummy that DIs, techs, gets up, counter-attacks out of hitstun and shield, recovers, and plays back your inputs.",
  "author": "PascalPatch",
  "license": "GPL-2.0-or-later",
  "tags": ["training", "hotkeys", "dummy"],
  "min_runtime": "0.3",
  "settings": [
    {"key": "pause_key", "group": "Hotkeys", "type": "key", "label": "Pause / resume", "default": "F5"},
    {"key": "step_key", "group": "Hotkeys", "type": "key", "label": "Frame advance", "default": "F6"},
    {"key": "slow_key", "group": "Hotkeys", "type": "key", "label": "Slow motion on / off", "default": "F7"},
    {"key": "slow_speed", "group": "Hotkeys", "type": "choice", "label": "Slow motion speed", "default": "half", "options": [{"value": "half", "label": "Half speed"}, {"value": "quarter", "label": "Quarter speed"}]},
    {"key": "reset_key", "group": "Hotkeys", "type": "key", "label": "Reset percent to 0", "default": "F9"},
    {"key": "who", "group": "Practice", "type": "choice", "label": "Percent, shield and stock options apply to", "default": "p2", "options": [{"value": "p1", "label": "Port 1"}, {"value": "p2", "label": "Port 2"}, {"value": "all", "label": "Everyone"}, {"value": "cpu", "label": "CPU players"}]},
    {"key": "lock_percent", "group": "Practice", "type": "bool", "label": "Lock percent", "default": false},
    {"key": "percent", "group": "Practice", "type": "int", "label": "Locked percent", "default": 60, "min": 0, "max": 999},
    {"key": "infinite_shield", "group": "Practice", "type": "bool", "label": "Infinite shield", "default": false},
    {"key": "endless_stocks", "group": "Practice", "type": "bool", "label": "Endless stocks", "default": false},
    {"key": "save_key", "group": "Savestates", "type": "key", "label": "Save state", "default": "End"},
    {"key": "load_key", "group": "Savestates", "type": "key", "label": "Load state", "default": "Delete"},
    {"key": "reload", "group": "Savestates", "type": "choice", "label": "Load the state again on its own", "default": "off", "options": [{"value": "off", "label": "Never"}, {"value": "exchange", "label": "When the exchange is over (the dummy's port is free again, or KO'd)"}, {"value": "3s", "label": "After 3 seconds"}, {"value": "5s", "label": "After 5 seconds"}]},
    {"key": "state_dpad", "group": "Savestates", "type": "bool", "label": "D-pad right saves, D-pad left loads (as in UnclePunch)", "default": true},
    {"key": "dummy", "group": "Dummy", "type": "bool", "label": "Dummy on when a match starts", "default": false},
    {"key": "dummy_key", "group": "Dummy", "type": "key", "label": "Dummy on / off", "default": "Home"},
    {"key": "dummy_port", "group": "Dummy", "type": "choice", "label": "Dummy port (set it to a human player)", "default": "p2", "options": [{"value": "p1", "label": "Port 1"}, {"value": "p2", "label": "Port 2"}, {"value": "p3", "label": "Port 3"}, {"value": "p4", "label": "Port 4"}]},
    {"key": "stance", "group": "Dummy", "type": "choice", "label": "Dummy stands", "default": "stand", "options": [{"value": "stand", "label": "Standing"}, {"value": "crouch", "label": "Crouching"}, {"value": "shield", "label": "Shielding"}, {"value": "jump", "label": "Jumping"}]},
    {"key": "di", "group": "Dummy reactions", "type": "choice", "label": "DI", "default": "survival", "options": [{"value": "none", "label": "None"}, {"value": "survival", "label": "Survival (up and in)"}, {"value": "combo", "label": "Combo (down and away)"}, {"value": "in", "label": "In"}, {"value": "out", "label": "Out"}, {"value": "random", "label": "Random"}]},
    {"key": "sdi", "group": "Dummy reactions", "type": "choice", "label": "SDI", "default": "none", "options": [{"value": "none", "label": "None"}, {"value": "some", "label": "Some"}, {"value": "max", "label": "As much as possible"}]},
    {"key": "tech", "group": "Dummy reactions", "type": "choice", "label": "Tech", "default": "random", "options": [{"value": "miss", "label": "Never (miss the tech)"}, {"value": "in_place", "label": "In place"}, {"value": "toward", "label": "Toward you"}, {"value": "away", "label": "Away from you"}, {"value": "random", "label": "Random (misses too)"}]},
    {"key": "getup", "group": "Dummy reactions", "type": "choice", "label": "Get up (after a missed tech)", "default": "random", "options": [{"value": "stand", "label": "Stand"}, {"value": "toward", "label": "Roll toward you"}, {"value": "away", "label": "Roll away"}, {"value": "attack", "label": "Getup attack"}, {"value": "random", "label": "Random"}]},
    {"key": "counter_hit", "group": "Dummy reactions", "type": "choice", "label": "When hitstun ends", "default": "none", "options": [{"value": "none", "label": "Nothing"}, {"value": "jump", "label": "Jump"}, {"value": "nair", "label": "Nair"}, {"value": "grab", "label": "Grab"}, {"value": "spot_dodge", "label": "Spot dodge"}, {"value": "roll_away", "label": "Roll away"}, {"value": "roll_toward", "label": "Roll in"}, {"value": "up_b", "label": "Up-B"}, {"value": "down_b", "label": "Down-B (shine)"}, {"value": "air_dodge", "label": "Air dodge"}, {"value": "attack", "label": "Attack (A)"}, {"value": "random", "label": "Random"}]},
    {"key": "counter_shield", "group": "Dummy reactions", "type": "choice", "label": "When shield stun ends", "default": "none", "options": [{"value": "none", "label": "Nothing"}, {"value": "jump", "label": "Jump"}, {"value": "nair", "label": "Nair"}, {"value": "grab", "label": "Grab"}, {"value": "spot_dodge", "label": "Spot dodge"}, {"value": "roll_away", "label": "Roll away"}, {"value": "roll_toward", "label": "Roll in"}, {"value": "up_b", "label": "Up-B"}, {"value": "down_b", "label": "Down-B (shine)"}, {"value": "air_dodge", "label": "Air dodge"}, {"value": "attack", "label": "Attack (A)"}, {"value": "random", "label": "Random"}]},
    {"key": "recover", "group": "Dummy reactions", "type": "bool", "label": "Recover to the stage when knocked off", "default": true},
    {"key": "mash", "group": "Dummy reactions", "type": "bool", "label": "Mash out of grabs", "default": false},
    {"key": "record_key", "group": "Recording", "type": "key", "label": "Record your inputs (start / stop)", "default": "PageUp"},
    {"key": "play_key", "group": "Recording", "type": "key", "label": "Dummy plays the recording (start / stop)", "default": "PageDown"},
    {"key": "record_port", "group": "Recording", "type": "choice", "label": "Record the inputs of", "default": "p1", "options": [{"value": "p1", "label": "Port 1"}, {"value": "p2", "label": "Port 2"}, {"value": "p3", "label": "Port 3"}, {"value": "p4", "label": "Port 4"}]},
    {"key": "loop", "group": "Recording", "type": "bool", "label": "Loop the playback", "default": true}
  ],
  "changes": "Savestates and a practice dummy (both need PascalPatch 0.5). Savestates: D-pad right (or End) saves the moment, D-pad left (or Delete) puts it back, as often as you like, or have it come back on its own after each try, as a drill. The dummy: pick a human port and it stands, crouches, shields or jumps; DIs (survival, combo, in, out, random) and SDIs; techs in place, toward or away, or misses and gets up the way you choose; answers the end of hitstun or shield stun with an action on the first possible frame (out-of-shield grabs, jump-cancelled up-Bs, spot dodges, nairs...); recovers to the stage when knocked off; mashes out of grabs; and plays back inputs you record (PageUp to record, PageDown to play, Home to switch the dummy on and off)."
}
