{
  "id": "info-display",
  "name": "Info Display",
  "version": "1.0.0",
  "abi": 1,
  "entry": "info-display.dll",
  "summary": "A lab-style panel of each fighter's numbers (state and frame, position, velocities, jumps, shield, intangibility, ledge timer), plus a flash the frame a fighter can act again.",
  "author": "PascalPatch",
  "license": "GPL-2.0-or-later",
  "tags": ["hud", "training", "lab"],
  "min_runtime": "0.3",
  "settings": [
    {"key": "ports", "type": "choice", "label": "Fighters", "default": "p1p2",
     "options": [{"value": "p1", "label": "Port 1"}, {"value": "p1p2", "label": "Ports 1 and 2"}, {"value": "all", "label": "All ports"}]},
    {"key": "row_state", "type": "bool", "label": "State and frame", "default": true},
    {"key": "row_pos", "type": "bool", "label": "Position", "default": true},
    {"key": "row_vel", "type": "bool", "label": "Own velocity", "default": true},
    {"key": "row_kb", "type": "bool", "label": "Knockback velocity", "default": true},
    {"key": "row_ground", "type": "bool", "label": "Ground speed", "default": false},
    {"key": "row_jumps", "type": "bool", "label": "Jumps left", "default": true},
    {"key": "row_shield", "type": "bool", "label": "Shield health", "default": true},
    {"key": "row_intang", "type": "bool", "label": "Intangibility", "default": true},
    {"key": "row_ledge", "type": "bool", "label": "Ledge regrab timer", "default": false},
    {"key": "row_stun", "type": "bool", "label": "Hitlag and hitstun", "default": false},
    {"key": "row_stick", "type": "bool", "label": "Stick and trigger", "default": false},
    {"key": "place", "type": "choice", "label": "Panels", "default": "top",
     "options": [{"value": "top", "label": "Top corners"}, {"value": "middle", "label": "Halfway down the sides"}]},
    {"key": "flash", "type": "bool", "label": "Flash when a fighter can act again", "default": true},
    {"key": "flash_all", "type": "bool", "label": "Flash every fighter, not just those with a panel", "default": true},
    {"key": "toggle_key", "type": "key", "label": "Show / hide", "default": "Insert"},
    {"key": "opacity", "type": "float", "label": "Opacity", "default": 0.9, "min": 0.3, "max": 1.0}
  ]
}
