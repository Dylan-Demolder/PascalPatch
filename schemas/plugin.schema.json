{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meleemod/plugin/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "api_version",
    "entrypoint",
    "capabilities",
    "dependencies",
    "game_versions",
    "online_safe"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "api_version": {
      "type": "integer",
      "minimum": 1
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "shutdown": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "game_versions": {
      "type": "array",
      "const": [
        "GALE01-1.02"
      ]
    },
    "online_safe": {
      "type": "boolean"
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string"
    },
    "static_signature": {
      "enum": [
        "none",
        "context"
      ]
    },
    "init_phase": {
      "enum": [
        "first-frame",
        "startup"
      ]
    },
    "frame_timing": {
      "type": "boolean"
    }
  }
}
