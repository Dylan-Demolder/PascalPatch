{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "version",
    "source",
    "sha256",
    "license",
    "compatibility",
    "dependencies",
    "maintainer"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "license": {
      "type": "string"
    },
    "compatibility": {
      "enum": [
        "online-safe",
        "offline-only",
        "unknown"
      ]
    },
    "dependencies": {
      "type": "array"
    },
    "maintainer": {
      "type": "string"
    }
  }
}
