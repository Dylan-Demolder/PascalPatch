{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meleemod/profile/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "game_version",
    "base_game",
    "plugins",
    "mods",
    "mode",
    "online_safe"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "game_version": {
      "const": "GALE01-1.02"
    },
    "base_game": {
      "type": "string",
      "minLength": 1
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "mods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "mode": {
      "enum": [
        "vanilla",
        "tournament-safe",
        "slippi",
        "offline"
      ]
    },
    "online_safe": {
      "type": "boolean"
    },
    "allow_priority": {
      "type": "boolean",
      "default": false
    },
    "decomp_repo": {
      "type": "string",
      "minLength": 1
    },
    "decomp_orig": {
      "type": "string",
      "minLength": 1
    },
    "plugin_source_root": {
      "type": "string",
      "minLength": 1
    },
    "runtime_root": {
      "type": "string",
      "minLength": 1
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "slot", "fighter_file"],
        "properties": {
          "package": {"type": "string", "minLength": 1},
          "slot": {"type": "string", "minLength": 1},
          "fighter_file": {"type": "string", "minLength": 1},
          "costume_file": {"type": "string", "minLength": 1},
          "animation_file": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
