{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pascalpatch/profile/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "game_version",
    "base_game",
    "plugins",
    "mods",
    "mode",
    "online_safe"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "game_version": {
      "const": "GALE01-1.02"
    },
    "base_game": {
      "type": "string",
      "minLength": 1
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "mods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "mode": {
      "enum": [
        "vanilla",
        "tournament-safe",
        "slippi",
        "offline"
      ]
    },
    "online_safe": {
      "type": "boolean"
    },
    "allow_priority": {
      "type": "boolean",
      "default": false
    },
    "unlock_all_characters": {
      "type": "boolean",
      "default": true,
      "description": "offline native builds: stage the unlock-all plugin so every character is selectable"
    },
    "decomp_repo": {
      "type": "string",
      "minLength": 1
    },
    "decomp_orig": {
      "type": "string",
      "minLength": 1
    },
    "plugin_source_root": {
      "type": "string",
      "minLength": 1
    },
    "runtime_root": {
      "type": "string",
      "minLength": 1
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "slot", "fighter_file"],
        "properties": {
          "package": {"type": "string", "minLength": 1},
          "slot": {"type": "string", "minLength": 1},
          "fighter_file": {"type": "string", "minLength": 1},
          "costume_file": {"type": "string", "minLength": 1},
          "animation_file": {"type": "string", "minLength": 1},
          "move_graft": {"type": "string", "minLength": 1},
          "portrait": {"type": "string", "minLength": 1, "description": "select-screen photo: <id>.portrait from Character Studio (136x188 RGB5A3)"},
          "icon": {"type": "string", "minLength": 1, "description": "select-screen grid icon: <id>.icon from Character Studio (64x56 RGB5A3)"},
          "stock": {"type": "string", "minLength": 1, "description": "stock icon above the damage in a match: <id>.stock from Character Studio (24x24 RGB5A3)"},
          "install": {"enum": ["replace", "new"], "default": "replace", "description": "replace: the character takes the slot's place; new: it is added to the game and the select screen as a new fighter built on the slot's fighter, which stays (at most 40)"}
        }
      }
    },
    "quick_match": {
      "type": "object",
      "additionalProperties": false,
      "description": "the match the game boots straight into (the quick-match plugin)",
      "properties": {
        "p1": {"$ref": "#/$defs/quick_match_fighter"},
        "p2": {"$ref": "#/$defs/quick_match_fighter"},
        "p2_player": {"enum": ["human", "none", "cpu1", "cpu2", "cpu3", "cpu4", "cpu5", "cpu6", "cpu7", "cpu8", "cpu9"]},
        "stage": {"enum": ["fd", "bf", "ys", "fod", "ps", "dl"]},
        "rules": {"enum": ["endless", "stock4", "stock1"]}
      }
    }
  },
  "$defs": {
    "quick_match_fighter": {
      "description": "a fighter slot name (fox, marth, ...) or a character number 0-25",
      "oneOf": [
        {"enum": ["captain-falcon", "donkey-kong", "fox", "mr-game-and-watch", "kirby", "bowser", "link", "luigi", "mario", "marth", "mewtwo", "ness", "peach", "pikachu", "ice-climbers", "jigglypuff", "samus", "yoshi", "zelda", "sheik", "falco", "young-link", "dr-mario", "roy", "pichu", "ganondorf"]},
        {"type": "integer", "minimum": 0, "maximum": 25}
      ]
    }
  }
}
