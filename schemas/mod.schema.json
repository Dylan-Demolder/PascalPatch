{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meleemod/mod/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "type",
    "source",
    "targets",
    "conflicts",
    "priority"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "type": {
      "const": "filesystem"
    },
    "source": {
      "type": "string"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).*$"
      },
      "minItems": 1
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "integer"
    },
    "capability": {
      "enum": [
        "visual-only",
        "gameplay-changing",
        "unknown"
      ]
    }
  }
}
